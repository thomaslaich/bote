{
    "asyncapi": "3.1.0",
    "info": {
        "title": "Chat Room API",
        "version": "1.0.0",
        "x-bote-perspective": "owner",
        "description": "The chat room API: clients post messages and read posted messages."
    },
    "defaultContentType": "application/json",
    "channels": {
        "chat:posts": {
            "address": "chat:posts",
            "messages": {
                "PostMessageCommand": {
                    "$ref": "#/components/messages/PostMessageCommand"
                }
            }
        },
        "chat:room-status": {
            "address": "chat:room-status",
            "messages": {
                "GetRoomStatusRequest": {
                    "$ref": "#/components/messages/GetRoomStatusRequest"
                }
            }
        },
        "chat:messages": {
            "address": "chat:messages",
            "messages": {
                "ChatMessagePosted": {
                    "$ref": "#/components/messages/ChatMessagePosted"
                }
            }
        },
        "GetRoomStatusReply": {
            "messages": {
                "GetRoomStatusReply": {
                    "$ref": "#/components/messages/GetRoomStatusReply"
                }
            }
        }
    },
    "operations": {
        "PostMessage": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/chat:posts"
            },
            "messages": [
                {
                    "$ref": "#/channels/chat:posts/messages/PostMessageCommand"
                }
            ],
            "summary": "Post a chat message to the room."
        },
        "GetRoomStatus": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/chat:room-status"
            },
            "messages": [
                {
                    "$ref": "#/channels/chat:room-status/messages/GetRoomStatusRequest"
                }
            ],
            "reply": {
                "address": {
                    "location": "$message.header#/reply_to"
                },
                "channel": {
                    "$ref": "#/channels/GetRoomStatusReply"
                },
                "messages": [
                    {
                        "$ref": "#/channels/GetRoomStatusReply/messages/GetRoomStatusReply"
                    }
                ]
            },
            "summary": "Get the current status of a room through Redis Streams request/reply."
        },
        "ChatMessages": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/chat:messages"
            },
            "messages": [
                {
                    "$ref": "#/channels/chat:messages/messages/ChatMessagePosted"
                }
            ],
            "summary": "Chat messages posted to the room."
        }
    },
    "components": {
        "messages": {
            "PostMessageCommand": {
                "name": "PostMessageCommand",
                "title": "PostMessageCommand",
                "contentType": "application/json",
                "payload": {
                    "$ref": "#/components/schemas/PostMessageCommand"
                },
                "summary": "Command to post a chat message to a room."
            },
            "GetRoomStatusRequest": {
                "name": "GetRoomStatusRequest",
                "title": "GetRoomStatusRequest",
                "contentType": "application/json",
                "payload": {
                    "$ref": "#/components/schemas/GetRoomStatusRequest"
                },
                "summary": "Request the current status of a room.",
                "headers": {
                    "type": "object",
                    "properties": {
                        "reply_to": {
                            "type": "string"
                        },
                        "correlation_id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "reply_to",
                        "correlation_id"
                    ]
                },
                "correlationId": {
                    "location": "$message.header#/correlation_id"
                }
            },
            "GetRoomStatusReply": {
                "name": "GetRoomStatusReply",
                "title": "GetRoomStatusReply",
                "contentType": "application/json",
                "payload": {
                    "$ref": "#/components/schemas/GetRoomStatusReply"
                },
                "summary": "The current status of a room.",
                "headers": {
                    "type": "object",
                    "properties": {
                        "correlation_id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "correlation_id"
                    ]
                },
                "correlationId": {
                    "location": "$message.header#/correlation_id"
                }
            },
            "ChatMessagePosted": {
                "name": "ChatMessagePosted",
                "title": "ChatMessagePosted",
                "contentType": "application/json",
                "payload": {
                    "type": "object",
                    "properties": {
                        "chatMessage": {
                            "$ref": "#/components/schemas/ChatMessagePosted"
                        }
                    },
                    "required": [
                        "chatMessage"
                    ]
                },
                "summary": "A chat message was posted to a room."
            }
        },
        "schemas": {
            "PostMessageCommand": {
                "type": "object",
                "description": "Command to post a chat message to a room.",
                "properties": {
                    "roomId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 1
                    }
                }
            },
            "ChatMessagePosted": {
                "type": "object",
                "description": "A chat message was posted to a room.",
                "properties": {
                    "roomId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 1
                    },
                    "sentAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "GetRoomStatusReply": {
                "type": "object",
                "description": "The current status of a room.",
                "properties": {
                    "roomId": {
                        "type": "string"
                    },
                    "activeUsers": {
                        "type": "integer"
                    }
                }
            },
            "GetRoomStatusRequest": {
                "type": "object",
                "description": "Request the current status of a room.",
                "properties": {
                    "roomId": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
