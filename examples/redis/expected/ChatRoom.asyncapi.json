{
    "asyncapi": "3.1.0",
    "info": {
        "title": "Chat Room API",
        "version": "1.0.0",
        "x-bote-perspective": "owner",
        "description": "The chat room API: clients post messages and read posted messages."
    },
    "defaultContentType": "application/json",
    "channels": {
        "chat:posts": {
            "address": "chat:posts",
            "messages": {
                "PostMessageInput": {
                    "$ref": "#/components/messages/PostMessageInput"
                }
            }
        },
        "chat:room-status": {
            "address": "chat:room-status",
            "messages": {
                "GetRoomStatusInput": {
                    "$ref": "#/components/messages/GetRoomStatusInput"
                }
            }
        },
        "chat:messages": {
            "address": "chat:messages",
            "messages": {
                "ChatMessagePosted": {
                    "$ref": "#/components/messages/ChatMessagePosted"
                }
            }
        },
        "GetRoomStatusReply": {
            "messages": {
                "GetRoomStatusOutput": {
                    "$ref": "#/components/messages/GetRoomStatusOutput"
                }
            }
        }
    },
    "operations": {
        "PostMessage": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/chat:posts"
            },
            "messages": [
                {
                    "$ref": "#/channels/chat:posts/messages/PostMessageInput"
                }
            ],
            "summary": "Post a chat message to the room."
        },
        "GetRoomStatus": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/chat:room-status"
            },
            "messages": [
                {
                    "$ref": "#/channels/chat:room-status/messages/GetRoomStatusInput"
                }
            ],
            "reply": {
                "address": {
                    "location": "$message.header#/reply_to"
                },
                "channel": {
                    "$ref": "#/channels/GetRoomStatusReply"
                },
                "messages": [
                    {
                        "$ref": "#/channels/GetRoomStatusReply/messages/GetRoomStatusOutput"
                    }
                ]
            },
            "summary": "Get the current status of a room through Redis Streams request/reply."
        },
        "ChatMessages": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/chat:messages"
            },
            "messages": [
                {
                    "$ref": "#/channels/chat:messages/messages/ChatMessagePosted"
                }
            ],
            "summary": "Chat messages posted to the room."
        }
    },
    "components": {
        "messages": {
            "PostMessageInput": {
                "name": "PostMessageInput",
                "title": "PostMessageInput",
                "contentType": "application/json",
                "payload": {
                    "$ref": "#/components/schemas/PostMessageInput"
                }
            },
            "GetRoomStatusInput": {
                "name": "GetRoomStatusInput",
                "title": "GetRoomStatusInput",
                "contentType": "application/json",
                "payload": {
                    "$ref": "#/components/schemas/GetRoomStatusInput"
                },
                "headers": {
                    "type": "object",
                    "properties": {
                        "reply_to": {
                            "type": "string"
                        },
                        "correlation_id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "reply_to",
                        "correlation_id"
                    ]
                },
                "correlationId": {
                    "location": "$message.header#/correlation_id"
                }
            },
            "GetRoomStatusOutput": {
                "name": "GetRoomStatusOutput",
                "title": "GetRoomStatusOutput",
                "contentType": "application/json",
                "payload": {
                    "$ref": "#/components/schemas/GetRoomStatusOutput"
                },
                "headers": {
                    "type": "object",
                    "properties": {
                        "correlation_id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "correlation_id"
                    ]
                },
                "correlationId": {
                    "location": "$message.header#/correlation_id"
                }
            },
            "ChatMessagePosted": {
                "name": "ChatMessagePosted",
                "title": "ChatMessagePosted",
                "contentType": "application/json",
                "payload": {
                    "type": "object",
                    "properties": {
                        "chatMessage": {
                            "$ref": "#/components/schemas/ChatMessagePosted"
                        }
                    },
                    "required": [
                        "chatMessage"
                    ]
                },
                "summary": "A chat message was posted to a room."
            }
        },
        "schemas": {
            "ChatMessagePosted": {
                "type": "object",
                "description": "A chat message was posted to a room.",
                "properties": {
                    "roomId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 1
                    },
                    "sentAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "GetRoomStatusOutput": {
                "type": "object",
                "properties": {
                    "roomId": {
                        "type": "string"
                    },
                    "activeUsers": {
                        "type": "integer"
                    }
                }
            },
            "GetRoomStatusInput": {
                "type": "object",
                "properties": {
                    "roomId": {
                        "type": "string"
                    }
                }
            },
            "PostMessageInput": {
                "type": "object",
                "properties": {
                    "roomId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 1
                    }
                }
            }
        }
    }
}
