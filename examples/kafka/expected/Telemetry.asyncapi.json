{
    "asyncapi": "3.1.0",
    "info": {
        "title": "Telemetry API",
        "version": "1.0.0",
        "description": "The telemetry API: sensors record readings and clients consume alerts."
    },
    "defaultContentType": "application/protobuf",
    "channels": {
        "telemetry.readings": {
            "address": "telemetry.readings",
            "messages": {
                "RecordReadingCommand": {
                    "$ref": "#/components/messages/RecordReadingCommand"
                }
            },
            "bindings": {
                "kafka": {
                    "topic": "telemetry.readings",
                    "bindingVersion": "0.5.0"
                }
            }
        },
        "telemetry.alerts": {
            "address": "telemetry.alerts",
            "messages": {
                "ThresholdExceeded": {
                    "$ref": "#/components/messages/ThresholdExceeded"
                }
            },
            "bindings": {
                "kafka": {
                    "topic": "telemetry.alerts",
                    "bindingVersion": "0.5.0"
                }
            }
        }
    },
    "operations": {
        "RecordReading": {
            "action": "receive",
            "channel": {
                "$ref": "#/channels/telemetry.readings"
            },
            "messages": [
                {
                    "$ref": "#/channels/telemetry.readings/messages/RecordReadingCommand"
                }
            ],
            "summary": "Record a sensor reading."
        },
        "ConsumeAlerts": {
            "action": "send",
            "channel": {
                "$ref": "#/channels/telemetry.alerts"
            },
            "messages": [
                {
                    "$ref": "#/channels/telemetry.alerts/messages/ThresholdExceeded"
                }
            ],
            "summary": "Consume threshold alerts derived from the readings."
        }
    },
    "components": {
        "messages": {
            "RecordReadingCommand": {
                "name": "RecordReadingCommand",
                "title": "RecordReadingCommand",
                "contentType": "application/protobuf",
                "payload": {
                    "$ref": "#/components/schemas/RecordReadingCommand"
                },
                "summary": "Command to record a sensor reading.",
                "bindings": {
                    "kafka": {
                        "key": {
                            "type": "string"
                        },
                        "bindingVersion": "0.5.0"
                    }
                }
            },
            "ThresholdExceeded": {
                "name": "ThresholdExceeded",
                "title": "ThresholdExceeded",
                "contentType": "application/protobuf",
                "payload": {
                    "$ref": "#/components/schemas/ThresholdExceeded"
                },
                "summary": "A sensor reading crossed its configured threshold.",
                "bindings": {
                    "kafka": {
                        "key": {
                            "type": "string"
                        },
                        "bindingVersion": "0.5.0"
                    }
                }
            }
        },
        "schemas": {
            "RecordReadingCommand": {
                "type": "object",
                "description": "Command to record a sensor reading.",
                "properties": {
                    "sensorId": {
                        "type": "string"
                    },
                    "milliCelsius": {
                        "type": "integer",
                        "description": "Temperature in thousandths of a degree Celsius."
                    },
                    "recordedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ThresholdExceeded": {
                "type": "object",
                "description": "A sensor reading crossed its configured threshold.",
                "properties": {
                    "sensorId": {
                        "type": "string"
                    },
                    "milliCelsius": {
                        "type": "integer"
                    },
                    "thresholdMilliCelsius": {
                        "type": "integer"
                    },
                    "observedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
