<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generates code from model/ with NSmithy and the bote C# generator, then tests it. The generator
    resolves from the staging Maven repository (`gradle publishAllPublicationsToStagingRepository`),
    which BOTE_MAVEN_REPO points at.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace></RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="NSmithy.MSBuild" PrivateAssets="all" />
    <PackageReference Include="NSmithy.SmithyCli" PrivateAssets="all" />
    <PackageReference Include="NSmithy.Core" />
    <PackageReference Include="NSmithy.Codecs.Json" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Bote.Messaging.Kafka/Bote.Messaging.Kafka.csproj" />
    <ProjectReference Include="../../src/Bote.Messaging.Redis/Bote.Messaging.Redis.csproj" />
  </ItemGroup>
</Project>
