    },
    "header": {
      "plugins": {
        "csharp-codegen": {
          "service": "tests.header#Device",
          "baseNamespace": ""
        }
      }
    },
    "none": {
      "plugins": {
        "csharp-codegen": {
          "service": "tests.none#Device",
          "baseNamespace": ""
        }
      }
    },
    "redisstreams": {
      "plugins": {
        "csharp-codegen": {
          "service": "tests.redisstreams#ChatRoom",
          "baseNamespace": ""
        }
      }
    },
    "redisreply": {
      "plugins": {
        "csharp-codegen": {
          "service": "tests.redisreply#Inventory",
          "baseNamespace": ""
        }
      }
    },
    "redispubsub": {
      "plugins": {
        "csharp-codegen": {
          "service": "tests.redispubsub#ChatRoom",
          "baseNamespace": ""
        }
      }
    }
  }
