{
  "version": "1.0",
  "sources": [
    "model"
  ],
  "maven": {
    "dependencies": [
      "io.github.thomaslaich.bote:smithy-csharp-codegen:0.1.0-SNAPSHOT"
    ],
    "repositories": [
      {
        "url": "file://${BOTE_MAVEN_REPO}"
      },
      {
        "url": "https://repo.maven.apache.org/maven2"
      }
    ]
  },
  "projections": {
    "envelope": {
      "plugins": {
        "csharp-codegen": {
          "service": "tests.envelope#Device",
